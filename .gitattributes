# Keep LF line endings on files that are executed inside Linux containers or by
# bash on the host. Without this, a Windows checkout with core.autocrlf=true
# rewrites them to CRLF and they fail with:
#   /bin/bash^M: bad interpreter: No such file or directory
#
# Deliberately scoped to executable/config files rather than a blanket
# `* text=auto`, so adding this file does not renormalize the whole tree for
# people with an existing checkout.

*.sh            text eol=lf
*.py            text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
Makefile        text eol=lf
*.mk            text eol=lf
.env.example    text eol=lf
docker-compose*.yml text eol=lf

# The agent runtime and its entrypoint scripts run in the per-agent container.
agent-image/scripts/*   text eol=lf
orchestrator/setup.sh   text eol=lf
orchestrator/entrypoint.sh text eol=lf

# Binary assets — never touch.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.pptx          binary
*.ico           binary

# The JVM toolchain (#1941) ships a tiny Maven sample project — Sample.java plus a
# JUnit test — used ONLY by toolchains/_shared/base-contract-check.sh to smoke-test
# that the JVM variant image can compile and run Java. It is a build FIXTURE, not
# repository source. Mark it vendored so GitHub's linguist stops classifying this
# (Node/Python) repo as a Java/Kotlin project: otherwise CodeQL *default setup*
# auto-adds a `java-kotlin` analysis, which — with build-mode:none on a PR that
# doesn't touch Java — extracts an empty database and fails with "no source code
# seen during build". Excluding the fixture drops java-kotlin from default-setup's
# auto-detected language list on the next default-branch scan.
toolchains/jvm/sample/**   linguist-vendored
