# Variant configuration for the `fullstack` toolchain, read by the shared
# `aee-toolchain` bootstrap (#1941). Everything stack-specific about this
# variant is HERE rather than in the script, which is what makes the next stack
# a Dockerfile plus this file instead of a code change (AC14).
#
# This is the `jvm` variant plus Node — one image for a repository that has a
# Java service and a Node/TypeScript front-end (or tooling) in the same tree.

AEE_TOOLCHAIN_ID=fullstack

# What counts as "this project pinned its version". mise reads all of these;
# the first one found walking up from the current directory wins.
AEE_TOOLCHAIN_PIN_FILES=".mise.toml mise.toml .config/mise/config.toml .tool-versions"

# Tools the image puts on PATH as shims, so a plain `mvn test` or `npm ci`
# works and picks up this project's pin from the current directory.
# `jshell`/`javap` are included because an agent debugging a build reaches for
# them and a missing one reads as a broken image; `corepack` is included so a
# repository using yarn/pnpm gets its package manager from the pinned Node.
AEE_TOOLCHAIN_SHIMS="java javac jar jshell javap mvn node npm npx corepack"

# Pin files belonging to a DIFFERENT version manager, or idiomatic single-tool
# files this image's mise does not read by default. A repository that committed
# one has declared its intent, so the "nothing pinned" error names it instead
# of claiming the repository said nothing. Commit a proper .mise.toml instead.
AEE_TOOLCHAIN_ALT_PINS=".sdkmanrc .java-version .nvmrc .node-version"

# The version you get if you do not pin (#1941 AC9, concept §8 open question 3).
AEE_TOOLCHAIN_BASELINE="java temurin-21, node 22, maven 3.9"
AEE_TOOLCHAIN_BASELINE_DATA=/opt/aee/toolchain/baseline
AEE_TOOLCHAIN_BASELINE_CONFIG=/opt/aee/toolchain/baseline/config.toml

# Root-dependent cache redirection, sourced after the workspace root is known.
AEE_TOOLCHAIN_EXTRA_ENV=/opt/aee/toolchain/cache-env.sh
