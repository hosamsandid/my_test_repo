#!/usr/bin/env python3
"""aee-emit — announce a label hand-off over the internal channel (#1173).

Why: a label hand-off wired with `transport: 'internal'` is NOT delivered by
the GitHub Events API round trip (poller latency, lost windows, throttles) —
the orchestrator delivers the wake directly to every internal listener's
durable queue, and only then mirrors the label onto the issue/PR so GitHub
stays the human-readable process state. Setting the label yourself with
`gh issue edit --add-label` would paint the status but wake NOBODY: internal
listeners are deliberately invisible to the poller. So when your trigger
prompt says to emit a label over the internal channel, use this:

    aee-emit ready --issue 42
    aee-emit qa:approved --pr 7
    aee-emit ready --issue 42 --repo my-clone-dir   # multi-repo environments

The orchestrator reports how many listeners were woken. `matched: 0` means
the hand-off reached no one — the label is still stamped as a status marker,
but the flow is mis-wired; surface that to the user instead of retrying.

Fail-closed: if the orchestrator is unreachable the hand-off was NOT
delivered — this tool exits non-zero and says so. Do not fall back to setting
the label manually; that cannot wake an internal listener.
"""

import json
import os
import subprocess
import sys
import urllib.error
import urllib.request

ORCH = (os.environ.get("ORCHESTRATOR_INTERNAL_URL")
        or os.environ.get("AEE_ORCHESTRATOR_URL")
        or "http://orchestrator:4002").rstrip("/")
TIMEOUT_SEC = 20


def die(msg: str, code: int = 2):
    sys.stderr.write(f"aee-emit: {msg}\n")
    sys.exit(code)


def usage():
    die("usage: aee-emit <label> (--issue <n> | --pr <n>) [--repo <clone-dir>]")


def resolve_repo_full_name(clone_dir: str | None) -> str:
    """owner/name from the clone's origin remote. Host-agnostic (the last two
    path segments), so github.com, SSH aliases and the E2E fake-github base
    all resolve the same way."""
    cmd = ["git"]
    if clone_dir:
        if not os.path.isdir(clone_dir):
            die(f"--repo '{clone_dir}': no such directory (expected a clone dir)")
        cmd += ["-C", clone_dir]
    cmd += ["remote", "get-url", "origin"]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        where = clone_dir or "the current directory"
        die(f"cannot read the origin remote of {where}: {(r.stderr or '').strip()}")
    url = r.stdout.strip()
    tail = url.replace(":", "/").rstrip("/")
    if tail.endswith(".git"):
        tail = tail[: -len(".git")]
    parts = [p for p in tail.split("/") if p]
    if len(parts) < 2:
        die(f"cannot derive owner/name from origin URL '{url}'")
    return f"{parts[-2]}/{parts[-1]}"


def main(argv: list[str]):
    label = None
    kind = None
    number = None
    clone_dir = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--issue", "--pr"):
            if kind is not None:
                die("pass exactly one of --issue / --pr")
            i += 1
            if i >= len(argv):
                usage()
            kind = "issue" if a == "--issue" else "pr"
            try:
                number = int(argv[i])
            except ValueError:
                die(f"{a} expects a number, got '{argv[i]}'")
        elif a == "--repo":
            i += 1
            if i >= len(argv):
                usage()
            clone_dir = argv[i]
        elif a.startswith("-"):
            usage()
        elif label is None:
            label = a
        else:
            usage()
        i += 1

    if not label or kind is None or number is None or number <= 0:
        usage()
    agent_id = os.environ.get("AGENT_ID")
    if not agent_id:
        die("AGENT_ID is not set in the environment")

    payload = {
        "agentId": agent_id,
        "repo": resolve_repo_full_name(clone_dir),
        "label": label,
        "target": {"kind": kind, "number": number},
    }
    req = urllib.request.Request(
        f"{ORCH}/internal/flow-emit",
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT_SEC) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        body = ""
        try:
            body = exc.read().decode("utf-8", "replace")[:300]
        except Exception:
            pass
        die(f"orchestrator rejected the emit (HTTP {exc.code}): {body}")
    except Exception as exc:
        die(f"could not reach the orchestrator at {ORCH} — the hand-off was "
            f"NOT delivered ({exc}). Do not fall back to setting the label "
            f"manually; that cannot wake an internal listener.")

    matched = data.get("matched", 0)
    ref = f"{payload['repo']}#{number}"
    if matched:
        who = ", ".join(
            f"{l.get('agentId')}({l.get('triggerId')})"
            for l in data.get("listeners", []))
        print(f"aee-emit: '{label}' on {ref} delivered to {matched} listener(s): {who}")
    else:
        sys.stderr.write(
            f"aee-emit: WARNING — '{label}' on {ref} matched NO internal "
            f"listener. The label was {'stamped as a status marker' if data.get('labelStamped') else 'NOT stamped either'}, "
            f"but no agent was woken; the flow wiring looks wrong. Surface this "
            f"to the user.\n")
    if not data.get("labelStamped"):
        sys.stderr.write(
            "aee-emit: note — the GitHub mirror label was not stamped "
            "(delivery itself is unaffected).\n")
    for w in data.get("warnings", []):
        sys.stderr.write(f"aee-emit: warning: {w}\n")


if __name__ == "__main__":
    main(sys.argv[1:])
