  "driftCases": [
    {
      "name": "in-sync",
      "input": {
        "copyHash": "A",
        "sourceHash": "A",
        "sourceCurrentHash": "A"
      },
      "expected": "in-sync"
    },
    {
      "name": "outdated (source moved on)",
      "input": {
        "copyHash": "A",
        "sourceHash": "A",
        "sourceCurrentHash": "B"
      },
      "expected": "outdated"
    },
    {
      "name": "diverged (copy edited locally)",
      "input": {
        "copyHash": "C",
        "sourceHash": "A",
        "sourceCurrentHash": "A"
      },
      "expected": "diverged"
    },
    {
      "name": "conflict (both changed)",
      "input": {
        "copyHash": "C",
        "sourceHash": "A",
        "sourceCurrentHash": "B"
      },
      "expected": "conflict"
    },
    {
      "name": "orphaned (source deleted)",
      "input": {
        "copyHash": "A",
        "sourceHash": "A",
        "sourceCurrentHash": null
      },
      "expected": "orphaned"
    },
    {
      "name": "not applicable (hand-authored, no sourceHash)",
      "input": {
        "copyHash": "A",
        "sourceHash": null,
        "sourceCurrentHash": "A"
      },
      "expected": null
    }
  ],
