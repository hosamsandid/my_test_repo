{
  "_comment": "GENERATED golden fixture for skill-manifest.js. Asserted byte-for-byte by admin-console/api/skill-manifest.test.js AND orchestrator/skill-manifest.test.js. Regenerate with the case list in those suites if the contract changes; change BOTH module copies in the same commit.",
  "hashCases": [
    {
      "name": "single SKILL.md",
      "files": [
        {
          "path": "SKILL.md",
          "text": "---\nname: x\n---\nbody\n"
        }
      ],
      "expectedHash": "c02c99de26ff"
    },
    {
      "name": "two files, order independent (supplied reversed)",
      "files": [
        {
          "path": "scripts/run.sh",
          "text": "echo hi\n"
        },
        {
          "path": "SKILL.md",
          "text": "a"
        }
      ],
      "expectedHash": "e1563c9da19f"
    },
    {
      "name": "exclusions ignored (skill.json/provenance.json/_archive)",
      "files": [
        {
          "path": "SKILL.md",
          "text": "---\nname: x\n---\nbody\n"
        },
        {
          "path": "skill.json",
          "text": "{\"v\":1,\"version\":9}"
        },
        {
          "path": "provenance.json",
          "text": "{\"entryIds\":[]}"
        },
        {
          "path": "_archive/old-SKILL.md",
          "text": "stale"
        }
      ],
      "expectedHash": "c02c99de26ff"
    },
    {
      "name": "nested dir file",
      "files": [
        {
          "path": "SKILL.md",
          "text": "a"
        },
        {
          "path": "refs/table.md",
          "text": "| a | b |\n"
        }
      ],
      "expectedHash": "bdb6e3c7645b"
    },
    {
      "name": "empty (no hashable files)",
      "files": [],
      "expectedHash": "e3b0c44298fc"
    },
    {
      "name": "content change flips hash",
      "files": [
        {
          "path": "SKILL.md",
          "text": "---\nname: x\n---\nbody EDITED\n"
        }
      ],
      "expectedHash": "4e9cd1f16eae"
    }
  ],
