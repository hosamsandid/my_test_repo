# Matrix access tokens — printed by setup.sh on first run
MATRIX_ACCESS_TOKEN=
ORCHESTRATOR_TOKEN=
MULTI_AGENT_ROOM=

# Room ID where the bot sends scheduled job output
# Format: !xxxx:local
MATRIX_DEFAULT_ROOM=

# Azure AI Foundry — Claude Code LLM endpoint
CLAUDE_CODE_USE_FOUNDRY=1
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6

# Admin Matrix user (human operator) — used by setup.sh and the orchestrator
ADMIN_USER=

# Instance isolation — change these per repo to run multiple stacks in parallel
COMPOSE_PROJECT_NAME=vgh-claw
CONDUWUIT_PORT=8448
CINNY_PORT=8090
ADMIN_PORT=4000
