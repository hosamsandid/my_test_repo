{
  "permissions": {
    "allow": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git worktree*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git merge*)",
      "Bash(git fetch*)",
      "Bash(git ls-remote*)",
      "Bash(python3 scripts/*)",
      "Bash(openssl rand*)"
    ]
  },
  "env": {
    "SASE_AUTO_APPROVAL_ENABLED": "true",
    "SASE_AUTO_APPROVAL_MIN_SCORE": "90",
    "SASE_AUTO_APPROVAL_REQUIRES_NO_SECURITY_CHANGES": "true",
    "SASE_AUTO_APPROVAL_REQUIRES_ALL_TESTS_PASS": "true",
    "SASE_AUTO_APPROVAL_REQUIRES_NO_UNRESOLVED_DEFERRED_CRPS": "true",
    "SASE_AUTO_APPROVAL_REQUIRES_ALL_ACS_MET": "true",
    "SASE_AUTO_APPROVAL_APPLIES_TO_TIERS": "standard",
    "SASE_BRANCH_PREFIX": "agent",
    "SASE_HEARTBEAT_INTERVAL_MINUTES": "60",
    "SASE_STALE_LOCK_THRESHOLD_MINUTES": "180"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // \"\"' | xargs -I{} sh -c 'case \"{}\" in */mentorscripts/*|*/CLAUDE.md) echo \"WARNING: Modifying protected MentorScript file. This requires explicit human authorization.\" ;; esac'"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // \"\"' | grep -q 'artifacts/briefings/.*/brief.md' && echo 'INFO: BP status change detected. Verify authorization per team.md.' || true"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/briefings-guard-hook.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/token-usage-hook.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"[\\(now | strftime(\"%Y-%m-%dT%H:%M:%SZ\"))] \\(.tool_name) \\(.tool_input.file_path // \"n/a\")\"' >> .claude/audit.log"
          }
        ]
      }
    ]
  }
}
