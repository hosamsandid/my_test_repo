{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://i-sase.dev/schemas/mrp.schema.json",
  "title": "MRP Frontmatter",
  "description": "Validates the YAML frontmatter of an i-SASE Milestone Review Packet (MRP). An MRP is submitted at phase gates for human review and approval before the loop can advance.",
  "type": "object",
  "required": ["schema", "id", "bp", "status"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "sase/mrp/v1",
      "description": "Schema identifier for the MRP artifact type."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$",
      "description": "Unique 12-character hex identifier for the MRP."
    },
    "bp": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$",
      "description": "Identifier of the BriefingPack this MRP is associated with."
    },
    "status": {
      "type": "string",
      "enum": ["pending-review", "approved", "rejected", "revision-requested"],
      "description": "Current review status of the MRP."
    },
    "auto-score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Automated quality score"
    },
    "auto-approved": {
      "type": "boolean",
      "description": "Whether this MRP was auto-approved"
    },
    "produced-by": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$",
      "description": "Agent-id that produced this MRP"
    },
    "reviewed-by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Team members who reviewed"
    },
    "approved-by": {
      "type": "string",
      "description": "Team member who approved"
    },
    "bp-revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Revision number of the BriefingPack this MRP was produced against."
    }
  }
}
