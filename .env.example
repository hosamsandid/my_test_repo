# Matrix admin access token — populated automatically by setup.sh on first run
MATRIX_ACCESS_TOKEN=

# Continuwuity admin room ID — populated automatically by ./orchestrator/setup.sh
# (resolved via the #admins:local alias). Leave blank for a fresh install;
# the bootstrap will fill it in. Continuwuity generates a deterministic ID
# per database; recreating the conduwuit-db volume produces a different ID
# and breaks the orchestrator unless this is updated.
# (Env var keeps the legacy CONDUWUIT_ prefix; the upstream project was
# renamed to Continuwuity but the variable name is preserved for
# backwards compatibility.)
CONDUWUIT_ADMIN_ROOM=

# Optional default room ID for scheduled job output (autonomous triggers
# fall back to the per-agent DM room with the admin if unset).
# Format: !xxxx:local
MATRIX_DEFAULT_ROOM=

# LLM endpoint (LiteLLM proxy or compatible Anthropic-API gateway)
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1

# Admin Matrix user (human operator) — used by setup.sh and the orchestrator
ADMIN_USER=
# Password for that Matrix user, read by ./orchestrator/setup.sh at bootstrap.
# If left empty the script prompts interactively — set it explicitly on Windows,
# where the Git Bash prompt is unreliable.
ADMIN_PASS=

# Admin Console login (#276). The whole console is served behind a login
# screen; these are the single credential pair it accepts. Change them for any
# shared/enterprise deployment — the defaults (admin / admin) are for first-boot
# local use only. This is a placeholder until enterprise SSO replaces it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Optional: secret used to sign session cookies. If unset, a stable secret is
# derived from the credentials (sessions then survive restarts and are
# invalidated automatically when the password changes). Set an explicit random
# value to rotate sessions independently of the password.
AUTH_SESSION_SECRET=
# Set to "true" only when the console is served over HTTPS, so the session
# cookie carries the Secure attribute. Leave unset for plain http://localhost.
AUTH_COOKIE_SECURE=
# Single-user <-> multi-user mode (#1457). Leave unset/"false" (the default)
# for single-user compatibility: whoever signs in is the operator and the team
# scope filter is a no-op, so an existing stack upgrades with no change in
# behaviour. Set to "true" to enforce multi-user scoping, where a caller sees
# only what their user record's team memberships allow. Resources created
# before activation are adopted into the "Default Team" automatically on the
# next restart, so activating needs no migration step. NOTE: turning this back
# off on a stack that already has named users grants every one of them full
# visibility — the console logs a warning at boot when that is the case.
AUTH_ENABLED=
# SSO via Google Cloud IAP (hosted GKE stack only). When set, a request whose
# IAP-signed JWT verifies against this audience is logged in as its Google
# identity — no login form. Format:
#   /projects/<project-number>/global/backendServices/<backend-service-id>
# (backend-service id: gcloud compute backend-services describe <name> --global
# --format='value(id)'). Leave unset for compose/kind — password login only.
IAP_AUDIENCE=

# ── Internal-API authentication for the orchestrator (#1456, GOV-PLATFORM-2) ──
# The orchestrator's internal API on :4002 is reachable by everything on the
# container network, agent containers included — so until this is armed, every
# console-side authorization check is bypassable by an agent that talks to :4002
# directly. Setting INTERNAL_API_TOKEN arms the gate:
#
#   * the admin console sends this value as a bearer header on every :4002 call
#     and gets the full /internal/* surface (it has already applied its own
#     per-user authorization before proxying);
#   * every agent container is given a DERIVED per-agent token instead, valid
#     only for the agent-facing routes and only for that agent's own id. The
#     control-plane token itself is stripped from the agent environment.
#
# Generate one with:  openssl rand -hex 32
# Leave EMPTY and the gate stays inert — the platform behaves exactly as it did
# before this landed. This is the intended state until you have run an observe
# week (below).
INTERNAL_API_TOKEN=
# The enforcement ladder (docs/governance-concept.md §3.2):
#   observe  (default) allow everything, but log every call that WOULD be
#            rejected — run this for a week to inventory every real caller,
#            including forgotten integrations. Grep the orchestrator log for
#            "[internal-auth]" and "verdict=would-deny".
#   warn     same, logged louder.
#   enforce  reject with 401/403.
# `enforce` without INTERNAL_API_TOKEN is refused at boot rather than silently
# locking every caller out.
INTERNAL_AUTH_MODE=
# Optional: sign per-agent tokens with an independent secret instead of one
# derived from INTERNAL_API_TOKEN. Changing either value invalidates every
# outstanding agent token; the new one is minted on the agent's next respawn.
INTERNAL_AGENT_TOKEN_SECRET=

# ACE / BriefingPack integration
# Absolute path to the i-sase / ACE repository on the host.
# When set, also uncomment the /ace bind-mounts in docker-compose.yml.
ACE_REPO_PATH=
ACE_WATCH_INTERVAL_SECONDS=30
ACE_BRIEFING_ENV_ID=briefing-pack

# Instance isolation — change these per repo to run multiple stacks in parallel.
#
# NOTE: `make` does not read this file. If you change COMPOSE_PROJECT_NAME, the
# `make seed-pool` target still targets the default `agent-studio_claude-workspace`
# volume while compose creates `<yourname>_claude-workspace`. Seed explicitly:
#   COMPOSE_PROJECT_NAME=<yourname> make seed-pool
COMPOSE_PROJECT_NAME=agent-studio
CONDUWUIT_PORT=8448
ADMIN_PORT=4000
# Port for the orchestrator's webhook server, which serves `http` triggers
# (POST /hooks/:agentId/:triggerId). Defaults to 4003 when unset.
HOOK_PORT=4003

# Optional baseline SSH key for the ORCHESTRATOR's own git operations (ACE
# briefings pull + orchestrator-side push/PR fallback). This is NOT needed to
# run Agent Studio and is NOT used by agents — every agent gets its own
# per-environment deploy key via the Admin Console (SSH Keys → Working
# Environment). Leave unset and the container starts with no host key present
# (the mount falls back to /dev/null). Set it to an absolute host path to a
# private key only if you want the orchestrator itself to authenticate git over
# SSH without a per-env key. Example:
#   ORCHESTRATOR_SSH_KEY=/home/you/.ssh/id_orchestrator
ORCHESTRATOR_SSH_KEY=

# Max simultaneous orchestrator respawn calls fired by one
# POST /api/llm-endpoints/:id/respawn-agents request (Model Registry's
# "restart agents" confirmation, triggered after a credential rotation).
# Each call stops+recreates a container; too many at once can strain a local
# Podman host. Leave unset to default to 5.
RESPAWN_CONCURRENCY=

# Rootless Podman API socket on the host. Mounted into orchestrator
# (read-write, for spawning agent containers) and admin-console (read-only,
# for the logs stream).
#
# Discover yours with:
#   podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}'
#
# macOS Podman Desktop (default):  /run/user/501/podman/podman.sock
# Windows Podman Desktop:          /run/user/1000/podman/podman.sock
# Linux rootless podman:           /run/user/<your-uid>/podman/podman.sock   (run: id -u)
#
# Leave unset to fall back to the macOS default baked into docker-compose.yml.
PODMAN_HOST_SOCKET=

