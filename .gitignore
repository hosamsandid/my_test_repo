.env
.env.e2e
plugins/*/broker/.env.local
.env.k8s
.env.k8s-e2e
.env.gke
.env.gke-preprod
.DS_Store
/.claude/audit.log
/.claude/settings.local.json
__pycache__/

# E2E (Playwright) local artifacts
/e2e/node_modules/
/e2e/test-results/
/e2e/playwright-report/
/e2e/.auth/
# Journey screenshot captures + manifest (#705) — regenerated by a green run,
# published as a CI artifact, never committed.
/e2e/artifacts/

# E2E git-remote fixture repo (generated by seed-fixture-repo.sh)
/e2e/git-remote/srv/e2e/

# Kind e2e stack scratch (#1319): port-forward PID files (kind-stack-up.sh)
/e2e/.kind-e2e/

# PR before/after screenshot workflow scratch (#709, ui-screenshots.yml) —
# the downloaded baseline + generated diff bundle, produced in CI only.
/baseline/
/visual-diff-out/

# Generated journey walkthrough deck (#708) — a build artifact rebuilt by
# `make docs-deck`, published as a CI artifact and human-visual-QA'd, never
# committed (binary; the journeys + screenshots are the real source).
/artifacts/*.pptx

# Generated journey walkthrough video (#712) — a build artifact assembled by
# `make video-journeys` from the journey screen recordings, published as a CI
# artifact and human-watched, never committed (binary; the journeys are the source).
/artifacts/*.webm

# Terraform (infra/gcp) — state stays local/GCS, never in git
.terraform/
*.tfstate
*.tfstate.*
.worktrees/
