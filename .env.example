# Matrix access token for the bot user (@claude:local)
MATRIX_ACCESS_TOKEN=

# Room ID where the bot sends scheduled job output
# Format: !xxxx:local
MATRIX_DEFAULT_ROOM=

# Azure AI Foundry — Claude Code LLM endpoint
CLAUDE_CODE_USE_FOUNDRY=1
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
