# Agent SDK Configuration for BP Explorer
# Copy this file to .env and fill in the values.

# Azure AI Foundry (recommended for ACN)
CLAUDE_CODE_USE_FOUNDRY=1
ANTHROPIC_FOUNDRY_RESOURCE=claude-code-ai-eastus2
ANTHROPIC_FOUNDRY_API_KEY=your-api-key-here
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6

# Direct Anthropic API (alternative — leave empty if using Foundry)
# ANTHROPIC_API_KEY=
